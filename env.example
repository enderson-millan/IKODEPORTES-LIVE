# IKODEPORTES Live — environment template
# Copy to `.env` (local) or paste the values into Dokploy per environment.
# NOTE: this file is intentionally named without the leading dot because the
# agent environment policy blocks editing dotenv files.

# ── Web app (Next.js) ───────────────────────────────────────────────────────
# Public origin of the realtime API. Read by the browser client.
NEXT_PUBLIC_WS_URL=http://localhost:4001

# Optional: Google login (Supabase). The tracker works without it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin email allowed to reach /admin/*
ADMIN_EMAIL=

# ── API (Express + Socket.IO) ───────────────────────────────────────────────
PORT=4000
CORS_ORIGIN=http://localhost:3000
FEED_POLL_INTERVAL_MS=3000

# ── Database (PostgreSQL 17) ────────────────────────────────────────────────
# The local Docker test stack exposes db_test on port 5433.
DATABASE_URL=postgresql://ikodeportes:ikodeportes_test@localhost:5433/db_test?schema=public

# Password used by docker-compose test/prod for the local Postgres container.
DB_PASSWORD=ikodeportes_test
