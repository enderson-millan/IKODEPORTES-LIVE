# IKODEPORTES Live — environment template
# Copy to `.env` (local) or paste the values into Dokploy per environment.
# NOTE: this file is intentionally named without the leading dot because the
# agent environment policy blocks editing dotenv files.

# ── Web app (Next.js) ───────────────────────────────────────────────────────
# Public origin of the realtime API. Read by the browser client.
NEXT_PUBLIC_WS_URL=http://localhost:4001

# Optional: Google login (Supabase). The tracker works without it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin email allowed to reach /admin/*
ADMIN_EMAIL=

# ── API (Express + Socket.IO) ───────────────────────────────────────────────
PORT=4000
CORS_ORIGIN=http://localhost:3100,https://live.ikodeportes.com
FEED_POLL_INTERVAL_MS=5000

# Feed LVBP (MLB StatsAPI: sportId 17, leagueId 135)
LEAGUE=LVBP
LVBP_SPORT_ID=17
LVBP_LEAGUE_ID=135
# Arranca el polling solo cuando se pide un partido (overlay / start).
LIVE_AUTO_DISCOVER=false
# Protege POST /api/live/games/:id/stop (si está vacío, el stop queda abierto).
CONTROL_TOKEN=

# URL del WebSocket que usan los server components. En local: http://localhost:4100
# Vacío = usa NEXT_PUBLIC_WS_URL (valor incrustado en el build).
LIVE_WS_URL=https://api.live.ikodeportes.com

# Tope de partidos monitoreados a la vez (protección ante /start públicos).
MAX_TRACKED_GAMES=20

# ── Base de datos (PostgreSQL 17) ───────────────────────────────────────────
# El stack local expone db_local en 5434 y el túnel usa la red interna.
DATABASE_URL=postgresql://ikodeportes:ikodeportes_local@localhost:5434/db_local?schema=public

DB_NAME=db_local
DB_USER=ikodeportes
DB_PASSWORD=ikodeportes_local

# ── Cloudflare Tunnel propio del PC (perfil "tunnel") ───────────────────────
# Crear un túnel separado en Zero Trust: ikodeportes-local
# Rutas: live.ikodeportes.com -> http://ikodeportes-web:3000
#        api.live.ikodeportes.com -> http://ikodeportes-api:4000
CLOUDFLARE_TUNNEL_TOKEN=
