{
  "name": "ikodeportes-api",
  "private": true,
  "version": "0.1.0",
  "description": "IKODEPORTES Live realtime API: Express + Socket.IO + Prisma.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format cjs --target node22 --clean --sourcemap --out-dir dist",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prisma:sync": "node scripts/sync-schema.cjs",
    "prisma:generate": "node scripts/sync-schema.cjs && prisma generate --schema prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema ../prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema ../prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.16.5",
    "prisma": "^6.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
